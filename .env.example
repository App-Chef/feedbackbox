# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by the public widget endpoint to store feedback.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app. Used in the install snippet and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Secret used to hash visitor IPs for rate limiting. Any long random string.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
